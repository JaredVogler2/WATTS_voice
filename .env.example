# Copy to your host's environment settings (Vercel project env vars / Posit
# Connect "Vars" panel). Never commit real keys.

# --- AI element mapping (pick one; LLM_PROVIDER=auto picks whichever has credentials)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# Boeing BCAI (inside the Boeing network only)
BCAI_PAT=
# BCAI_API_URL=https://boeingai-test.web.boeing.com/bcai-public-api/conversation
# BCAI_MODEL=gpt-5.4-mini
# BCAI_CA_BUNDLE=true

# --- Optional server speech-to-text (fallback when Siri/Dictation is blocked)
STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=gpt-4o-mini-transcribe

# --- Optional shared code required by /api/interpret and /api/transcribe
APP_ACCESS_CODE=
